{
  "name": "loud-ledger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fast": "vite --mode qa",
    "build": "npm run contracts:compile && tsc -b && vite build --mode production",
    "build:qa": "tsc -b && vite build --mode qa",
    "build:file": "tsc -b && vite build --mode file --outDir dist-file",
    "build:peer": "tsc -b && vite build --mode peer --outDir peer-demo",
    "catalog:validate": "node scripts/validate-access-genesis.mjs",
    "contracts:compile": "npm run catalog:validate && node scripts/compile-contracts.mjs",
    "contracts:estimate": "npm run contracts:compile && node scripts/estimate-contract-cost.mjs",
    "contracts:deploy:robinhood": "npm run contracts:compile && node scripts/deploy-robinhood.mjs",
    "test": "npm run contracts:compile && vitest run"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@vitejs/plugin-react": "latest",
    "ethers": "6.17.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "hardhat": "3.14.0",
    "solc": "0.8.30",
    "typescript": "latest",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "latest"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
